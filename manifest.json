{
  "manifest_version": 3,
  "name": "SalesEZ: LinkedIn Sales Navigator Scraper",
  "short_name": "SalesEZ",
  "version": "1.0",
  "description": "Export LinkedIn Sales Navigator leads to Google Sheets or CSV in one click. Auto-scrub names, titles, companies & URLs 100% locally.",
  "homepage_url": "https://github.com/sahil-exz/SalesEZ-LinkedIn-Sales-Navigator-Scraper",
  "permissions": [
    "storage",
    "cookies",
    "alarms",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SalesEZ: LinkedIn Sales Navigator Scraper",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}